---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt?: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
const altText = alt ?? caption ?? "";

// 680/1360/2040 covers 1x/2x/3x DPR at --content-width (global.css);
// keep the ladder and the sizes string in sync with that variable.
// Animated GIFs skip resizing: it would re-encode every frame.
const fullWidth = src.format !== "gif" ? Math.min(2040, src.width) : undefined;
// The browser picks from srcset candidates only, so fullWidth has to be one
// of them for the zoom upgrade to reach it.
const widths = fullWidth
  ? [...[680, 1360].filter((w) => w < fullWidth), fullWidth]
  : undefined;
// `auto`: supporting browsers size lazy-loaded images from the measured
// layout width; the rest skip the unknown entry and use the manual list.
const sizes = widths ? "auto, (max-width: 680px) 100vw, 680px" : undefined;

// Same transform as the fallback src: anchor, fallback, and top srcset
// candidate share one URL.
const zoomHref = (await getImage({ src, width: fullWidth })).src;
---

<figure>
  <a
    class="figure-zoom"
    href={zoomHref}
    aria-label={altText ? undefined : "View full-size image"}
  >
    <Image
      src={src}
      alt={altText}
      loading="lazy"
      width={fullWidth}
      widths={widths}
      sizes={sizes}
    />
  </a>
  {
    caption && (
      <figcaption>
        <p set:html={caption} />
      </figcaption>
    )
  }
</figure>
<script>
  import { attachImageZoom } from "../lib/image-zoom";

  // The anchor covers no-JS visitors with plain navigation to the file; with
  // JS it becomes the zoom trigger. The zoom starts instantly from the img's
  // width/height attributes; the module's `sizes` bump then makes the browser
  // fetch the full srcset candidate (same URL as the anchor href) and sharpen
  // the pixels in place.
  attachImageZoom(
    document.querySelectorAll<HTMLAnchorElement>("a.figure-zoom"),
    {
      backdrop: "color-mix(in srgb, var(--bg) 90%, transparent)",
      padding: 16,
    },
  );
</script>
