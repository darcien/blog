---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: string | ImageMetadata;
  alt?: string;
  caption?: string;
  resize?: string;
}

const { src, alt, caption } = Astro.props;
const altText = alt ?? caption ?? "";
const isImported = typeof src !== "string";
---

<figure>
  {
    isImported ? (
      <Image src={src} alt={altText} loading="lazy" />
    ) : (
      <img loading="lazy" src={src} alt={altText} />
    )
  }
  {
    caption && (
      <figcaption>
        <p set:html={caption} />
      </figcaption>
    )
  }
</figure>
<script>
  // @ts-ignore
  import Lightense from "lightense-images";

  const selector = "img:not(.site-logo)";
  Lightense(selector, {
    background: "color-mix(in srgb, var(--bg) 90%, transparent)",
    padding: 16,
  });

  // Lightense binds mouse-click only (fails WCAG 2.1.1 Keyboard). Make each image
  // a focusable button opened via Enter/Space through lightense's click handler
  // (Escape-close already works). Done in JS so it stays a plain image without JS.
  for (const img of document.querySelectorAll<HTMLImageElement>(selector)) {
    img.setAttribute("role", "button");
    img.tabIndex = 0;
    // a button needs an accessible name; fall back when the image has no alt
    if (!img.alt && !img.getAttribute("aria-label")) {
      img.setAttribute("aria-label", "View image larger");
    }
    img.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") {
        event.preventDefault();
        img.click();
      }
    });
  }
</script>
