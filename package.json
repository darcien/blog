{
  "name": "blog",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "fmt": "prettier --cache --cache-strategy content --write .",
    "fmt:check": "prettier --cache --cache-strategy content --check ."
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.0",
    "@astrojs/mdx": "6.0.3",
    "@astrojs/rss": "4.0.18",
    "@astrojs/sitemap": "3.7.3",
    "astro": "6.4.6",
    "lightense-images": "1.0.17",
    "rehype-autolink-headings": "7.1.0",
    "rehype-external-links": "3.0.0",
    "rehype-slug": "6.0.0",
    "sharp": "0.35.1"
  },
  "devDependencies": {
    "pagefind": "1.5.2",
    "prettier": "3.8.4",
    "prettier-plugin-astro": "0.14.1"
  }
}
