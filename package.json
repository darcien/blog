{
  "name": "blog",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "fmt": "prettier --cache --cache-strategy content --write .",
    "fmt:check": "prettier --cache --cache-strategy content --check .",
    "precommit": "bun run fmt && astro check"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.3.2",
    "@astrojs/mdx": "7.0.0",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.0.4",
    "github-slugger": "2.0.0",
    "lightense-images": "1.0.17",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "pagefind": "1.5.2",
    "prettier": "3.9.4",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6"
  }
}
